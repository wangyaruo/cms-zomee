# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=replace-with-a-long-random-secret
DATABASE_URL=file:./data/zomeex-cms.db
PAYLOAD_DB_PUSH=true
NEXT_PUBLIC_SERVER_URL=http://localhost:3100
# Set to false only when accessing the deployed CMS over HTTP; remove for HTTPS.
CMS_COOKIE_SECURE=true
# Set to /opt/zomeex-cms when release uploads link to shared directories.
# CMS_BUILD_ROOT=/opt/zomeex-cms
CMS_BOOTSTRAP_EMAIL=admin@example.com
CMS_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
# Comma-separated origins allowed to read published snapshots.
SNAPSHOT_TOKEN=replace-with-an-independent-random-token
SNAPSHOT_ALLOWED_ORIGINS=http://localhost:5273
ORIGINAL_CONTENT_FILE=import/original-content.json
ORIGINAL_PUBLIC_DIR=../zomme-index/public
